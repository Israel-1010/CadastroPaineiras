# Copie para .env.local (desenvolvimento) ou configure no servidor de produção.

# Supabase (a service role key é usada só no servidor; nunca prefixar com NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=

# Sessão: segredo aleatório com 32+ caracteres. Trocar invalida todas as sessões.
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=
# Opcional: o cookie é Secure automaticamente quando o acesso é por HTTPS. Use true/false para forçar.
# COOKIE_SECURE=false

# S3 (fotos dos dependentes)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# Terminais faciais Dahua (obrigatórios; sem valores padrão)
DAHUA_USER=
DAHUA_PASS=
# IPs separados por vírgula
DAHUA_IPS=
# Opcionais do cartão de acesso (padrões: 123456 e 01018001, como na versão anterior)
# DAHUA_CARD_PASSWORD=
# DAHUA_VTO_POSITION=

NEXT_PUBLIC_BASE_URL=
